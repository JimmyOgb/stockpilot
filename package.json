{
  "name": "stockpilot",
  "version": "0.1.0",
  "description": "Autonomous BSC agent for tokenized-stock allocation, verification, and spot rebalancing",
  "author": "StockPilot Team",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:ui": "vite build",
    "build:all": "tsc && vite build",
    "start": "node dist/server/index.js",
    "dev": "tsx watch src/server/index.ts",
    "dev:ui": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "tsx scripts/smoke-test-readonly-integration.ts",
    "test:smoke:market": "tsx scripts/smoke-test-market-data.ts",
    "test:smoke:simulation": "tsx scripts/smoke-test-simulation.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "genlayer-js": "^1.1.8",
    "lucide-react": "^1.48.0",
    "mp4box": "^2.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vercel": "^60.1.3",
    "vite": "^7.3.6",
    "vitest": "^3.0.6"
  }
}
