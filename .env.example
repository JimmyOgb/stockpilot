# ==============================================================================
# StockPilot — Environment Variables Template
# ==============================================================================
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS.
# NEVER COMMIT .env TO VERSION CONTROL OR EXPOSE SECRETS TO CLIENT CODE.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Network & RPC Settings (BSC Mainnet)
BSC_RPC_URL=https://bsc-dataseed.binance.org/
BSC_CHAIN_ID=56

# Binance Web3 API & Wallet Configuration
# Used for querying spot quotes, DEX aggregation routes, and Agentic Wallet interaction
BINANCE_WEB3_API_BASE_URL=https://api.binance.com
BINANCE_WEB3_API_KEY=your_binance_web3_api_key_here
BINANCE_WEB3_API_SECRET=your_binance_web3_api_secret_here

# Binance Web3 Agentic Wallet / Execution Signer (Server-side only)
# Supports Binance Web3 Wallet MPC / Agentic signer or BSC private key for spot execution
EXECUTOR_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
EXECUTOR_PRIVATE_KEY=your_server_side_private_key_here

# GenLayer Independent Verification Gate
# RPC or endpoint for the GenLayer verification layer
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_VERIFIER_CONTRACT=0x801A94870ecADe3Aedd0f8D070498Ad954b63841
VERIFICATION_TIMEOUT_MS=10000

# Target Assets on BSC Mainnet
# Tokenized stock asset (e.g. bNVDA or Ondo US equity token on BSC)
TOKENIZED_STOCK_SYMBOL=bNVDA
TOKENIZED_STOCK_ADDRESS=0x0000000000000000000000000000000000000000
TOKENIZED_STOCK_DECIMALS=18

# Counter-asset stablecoin (USDC on BSC)
STABLECOIN_SYMBOL=USDC
STABLECOIN_ADDRESS=0x8AC76a51cc950d9822D68b83fE1Ad97B32Cd580d
STABLECOIN_DECIMALS=18

# Deterministic Risk & Staleness Guards
# Max allowable age of reference/oracle quote before triggering REFERENCE_STALE
MAX_STALENESS_SECONDS=900

# Max allowable slippage in basis points (50 bps = 0.5%)
MAX_SLIPPAGE_BPS=50

# Max allowable slippage when market is closed (25 bps = 0.25%)
MAX_SLIPPAGE_CLOSED_BPS=25

# Max trade size per single rebalance in USD (circuit breaker)
MAX_SINGLE_REBALANCE_USD=5000
